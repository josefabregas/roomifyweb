{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "https://biljpbkwkeztjtrbynkf.supabase.co/functions/v1/site/:slug"
    }
  ],
  "headers": [
    {
      "source": "/p/:slug",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
